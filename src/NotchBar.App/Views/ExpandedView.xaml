<UserControl x:Class="NotchBar.App.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NotchBar.App.Views"
             xmlns:vm="clr-namespace:NotchBar.App.ViewModels"
             Width="{DynamicResource Size.Expanded.Width}"
             Height="{DynamicResource Size.Expanded.Height}">
    <!-- DataContext: NotchContentViewModel. Tamaño fijo para que no se recoloque durante la animación. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:NowPlayingView DataContext="{Binding NowPlaying}"
                              Visibility="{Binding DataContext.IsNowPlayingActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}" />
        <views:LyricsView DataContext="{Binding Lyrics}"
                          Visibility="{Binding DataContext.IsLyricsActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}" />
        <!-- El vinilo solo gira mientras se ve: lo decide VinylView con IsVisible. -->
        <views:VinylView DataContext="{Binding NowPlaying}"
                         Visibility="{Binding DataContext.IsVinylActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}" />
        <views:ClipboardView DataContext="{Binding Clipboard}"
                             Visibility="{Binding DataContext.IsClipboardActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}" />

        <!-- Pestañas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{DynamicResource Space.TabBar}">
            <Button Content="Ahora suena"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="{x:Static vm:NotchPanel.NowPlaying}"
                    AutomationProperties.Name="Pestaña Ahora suena">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNowPlayingActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Letras"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="{x:Static vm:NotchPanel.Lyrics}"
                    AutomationProperties.Name="Pestaña Letras">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLyricsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Vinilo"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="{x:Static vm:NotchPanel.Vinyl}"
                    AutomationProperties.Name="Pestaña Vinilo">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVinylActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Portapapeles"
                    Command="{Binding ShowPanelCommand}"
                    CommandParameter="{x:Static vm:NotchPanel.Clipboard}"
                    AutomationProperties.Name="Pestaña Portapapeles">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClipboardActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
