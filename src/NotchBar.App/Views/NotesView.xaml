<UserControl x:Class="NotchBar.App.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NotchBar.App.Views">
    <!-- DataContext: NotesViewModel -->

    <Grid Margin="{DynamicResource Padding.Expanded}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{DynamicResource Size.NotesListWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Escribir: al hacer clic aquí el notch acepta el teclado (ver NotchWindow, "modo escritura"). -->
        <Grid>
            <TextBox x:Name="NoteBox"
                     Style="{DynamicResource NoteTextBox}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Nota">
                <TextBox.InputBindings>
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <!-- Texto de ayuda mientras está vacío -->
            <TextBlock Text="Escribe una nota… (Ctrl+Enter guarda)"
                       Margin="{DynamicResource Padding.Note}"
                       IsHitTestVisible="False"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{DynamicResource Space.Above}">
            <Button Style="{DynamicResource ChipButton}"
                    Content="Guardar"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Guardar nota" />
            <TextBlock Text="{Binding Status}"
                       Margin="{DynamicResource Space.Inline}"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Micro}"
                       Foreground="{DynamicResource Brush.TextMuted}" />
        </StackPanel>

        <!-- Últimas notas: clic para abrirla con el editor de Windows -->
        <ScrollViewer Grid.Column="1" Margin="{DynamicResource Space.Gap}" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource ListRowButton}"
                                Content="{Binding Preview}"
                                ToolTip="{Binding When}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=views:NotesView}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Preview, StringFormat=Abrir nota: {0}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" Grid.Column="1"
                Style="{DynamicResource ChipButton}"
                Margin="{DynamicResource Space.GapAbove}"
                HorizontalAlignment="Right"
                Content="Abrir carpeta"
                Command="{Binding OpenFolderCommand}"
                AutomationProperties.Name="Abrir carpeta de notas" />
    </Grid>
</UserControl>
