<UserControl x:Class="NotchBar.App.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NotchBar.App.Views">
    <!-- DataContext: LyricsViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Padding.Expanded}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mensaje (buscando, sin letra, instrumental...) -->
        <TextBlock Text="{Binding Status}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Main}"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}" />

        <!-- Tres líneas: anterior (apagada), actual (resaltada), siguiente (apagada) -->
        <StackPanel VerticalAlignment="Center"
                    Visibility="{Binding HasSyncedLyrics, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock Text="{Binding PreviousLine}"
                       Style="{DynamicResource LyricDimLine}" />
            <TextBlock x:Name="CurrentLineText"
                       Text="{Binding CurrentLine}"
                       Margin="{DynamicResource Space.LyricCurrent}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Lyric}"
                       FontWeight="{DynamicResource FontWeight.Title}"
                       Foreground="{DynamicResource Brush.Accent}">
                <TextBlock.RenderTransform>
                    <TranslateTransform />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{Binding NextLine}"
                       Style="{DynamicResource LyricDimLine}" />
        </StackPanel>

        <!-- Abajo: controles de música en el centro, desfase a la derecha -->
        <Grid Grid.Row="1">
            <!-- Los mismos botones de "Ahora suena", para pausar sin cambiar de pestaña. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        DataContext="{Binding DataContext.NowPlaying, RelativeSource={RelativeSource AncestorType=views:ExpandedView}}">
                <Button Style="{DynamicResource SmallIconButton}"
                        Command="{Binding PreviousCommand}"
                        Content="&#xE892;"
                        AutomationProperties.Name="Anterior (letras)" />
                <Button Command="{Binding PlayPauseCommand}"
                        AutomationProperties.Name="Reproducir o pausar (letras)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                            <Setter Property="Content" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="&#xE769;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{DynamicResource SmallIconButton}"
                        Command="{Binding NextCommand}"
                        Content="&#xE893;"
                        AutomationProperties.Name="Siguiente (letras)" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding HasSyncedLyrics, Converter={StaticResource VisibleIfTrue}}">
                <Button Style="{DynamicResource ChipButton}"
                        Content="−"
                        Command="{Binding OffsetLaterCommand}"
                        ToolTip="La letra va adelantada: retrasarla 0,5 s"
                        AutomationProperties.Name="Retrasar letra" />
                <TextBlock Text="{Binding OffsetLabel}"
                           Margin="{DynamicResource Space.Inline}"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="{DynamicResource FontSize.Micro}"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <Button Style="{DynamicResource ChipButton}"
                        Content="+"
                        Command="{Binding OffsetEarlierCommand}"
                        ToolTip="La letra va atrasada: adelantarla 0,5 s"
                        AutomationProperties.Name="Adelantar letra" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
