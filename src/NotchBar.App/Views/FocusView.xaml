<UserControl x:Class="NotchBar.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NotchBar.App.Views">
    <!-- DataContext: FocusViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Padding.Expanded}">

        <!-- Sin sesión: elegir cuánto tiempo -->
        <StackPanel VerticalAlignment="Center"
                    Visibility="{Binding IsIdle, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock Text="¿Cuánto tiempo quieres concentrarte?"
                       HorizontalAlignment="Center"
                       Margin="{DynamicResource Space.Below}"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <ItemsControl ItemsSource="{Binding Presets}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource ChipButton}"
                                Margin="{DynamicResource Space.Chip}"
                                FontSize="{DynamicResource FontSize.Small}"
                                Content="{Binding Label}"
                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=views:FocusView}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Label, StringFormat=Concentrarme {0}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- En marcha o en pausa: el tiempo que queda -->
        <StackPanel VerticalAlignment="Center"
                    Visibility="{Binding IsActive, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock Text="{Binding RemainingText}"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Timer}"
                       FontWeight="{DynamicResource FontWeight.Title}"
                       Foreground="{DynamicResource Brush.Accent}"
                       AutomationProperties.Name="Tiempo restante" />
            <TextBlock Text="{Binding DurationText}"
                       HorizontalAlignment="Center"
                       Margin="{DynamicResource Space.Below}"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Micro}"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <ProgressBar Style="{DynamicResource ThinProgressBar}"
                         Width="{DynamicResource Size.FocusProgress}"
                         Margin="{DynamicResource Space.Below}"
                         Value="{Binding Progress, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PauseOrResumeCommand}"
                        Margin="{DynamicResource Space.Chip}"
                        AutomationProperties.Name="Pausar o continuar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Setter Property="Content" Value="Pausar" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="Continuar" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{DynamicResource ChipButton}"
                        Margin="{DynamicResource Space.Chip}"
                        Content="Cancelar"
                        Command="{Binding ResetCommand}"
                        AutomationProperties.Name="Cancelar concentración" />
            </StackPanel>
        </StackPanel>

        <!-- Terminado -->
        <StackPanel VerticalAlignment="Center"
                    Visibility="{Binding IsFinished, Converter={StaticResource VisibleIfTrue}}">
            <TextBlock Text="¡Tiempo cumplido!"
                       HorizontalAlignment="Center"
                       Margin="{DynamicResource Space.Below}"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Lyric}"
                       FontWeight="{DynamicResource FontWeight.Title}"
                       Foreground="{DynamicResource Brush.Accent}" />
            <Button Style="{DynamicResource ChipButton}"
                    HorizontalAlignment="Center"
                    Content="Aceptar"
                    Command="{Binding ResetCommand}"
                    AutomationProperties.Name="Aceptar fin de concentración" />
        </StackPanel>
    </Grid>
</UserControl>
