<UserControl x:Class="NotchBar.App.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: NowPlayingViewModel. Ocupa el espacio que le da ExpandedView. -->

    <Grid Margin="{DynamicResource Padding.Expanded}">
        <!-- Nada sonando -->
        <TextBlock Text="Nada en reproducción"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Main}"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMedia}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Carátula (si no hay, queda el cuadro de color Surface) -->
            <Border Width="{DynamicResource Size.Cover}"
                    Height="{DynamicResource Size.Cover}"
                    VerticalAlignment="Center"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Surface}">
                <Border CornerRadius="{DynamicResource Radius.Control}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>

            <Grid Grid.Column="1" Margin="{DynamicResource Space.Gap}" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="{DynamicResource FontSize.Title}"
                           FontWeight="{DynamicResource FontWeight.Title}"
                           Foreground="{DynamicResource Brush.Text}" />

                <TextBlock Grid.Row="1"
                           Text="{Binding Artist}"
                           Margin="{DynamicResource Space.Below}"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{DynamicResource Space.Below}">
                    <!-- Iconos de Segoe Fluent Icons: E892 anterior, E768 reproducir, E769 pausa, E893 siguiente -->
                    <Button Style="{DynamicResource IconButton}"
                            Command="{Binding PreviousCommand}"
                            Content="&#xE892;"
                            AutomationProperties.Name="Anterior" />
                    <Button Command="{Binding PlayPauseCommand}"
                            AutomationProperties.Name="Reproducir o pausar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE768;" />
                                <Setter Property="FontSize" Value="{DynamicResource FontSize.IconLarge}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#xE769;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{DynamicResource IconButton}"
                            Command="{Binding NextCommand}"
                            Content="&#xE893;"
                            AutomationProperties.Name="Siguiente" />
                </StackPanel>

                <ProgressBar Grid.Row="3" Style="{DynamicResource ThinProgressBar}" Value="{Binding Progress, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Reproductor: cada clic pasa al siguiente (Auto → Chrome → MusicBee → Auto). -->
        <Button Style="{DynamicResource ChipButton}"
                Content="{Binding SourceLabel}"
                Command="{Binding NextSourceCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTip="Cambiar de reproductor"
                AutomationProperties.Name="Cambiar de reproductor">
            <Button.Visibility>
                <Binding Path="ShowSourceLabel">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </Button.Visibility>
        </Button>
    </Grid>
</UserControl>
