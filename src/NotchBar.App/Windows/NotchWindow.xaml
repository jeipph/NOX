<Window x:Class="NotchBar.App.Windows.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NotchBar.App.Views"
        Title="NotchBar"
        Width="{DynamicResource Size.Window.Width}"
        Height="{DynamicResource Size.Window.Height}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- La ventana es transparente (el ratón la atraviesa); solo la pastilla crece y encoge.
         Tamaño, esquinas, margen y fondo de la pastilla se asignan desde el código según el estilo. -->
    <Border x:Name="Pill"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            ClipToBounds="True"
            MouseEnter="OnPillMouseEnter"
            MouseLeave="OnPillMouseLeave">

        <!-- DataContext de la pastilla: NotchContentViewModel (se asigna en el código). -->
        <Grid>
            <!-- Contraído: título corto de la canción. -->
            <TextBlock x:Name="CollapsedContent"
                       Text="{Binding NowPlaying.ShortTitle}"
                       Margin="{DynamicResource Padding.Collapsed}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Micro}"
                       Foreground="{DynamicResource Brush.Text}" />

            <!-- Expandido: pestañas "Ahora suena" y "Letras". -->
            <views:ExpandedView x:Name="ExpandedContent"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
