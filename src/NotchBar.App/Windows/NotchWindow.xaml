<Window x:Class="NotchBar.App.Windows.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchBar"
        Width="{DynamicResource Size.Expanded.Width}"
        Height="{DynamicResource Size.Expanded.Height}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- La ventana mide siempre lo del notch expandido y es transparente (el ratón la atraviesa);
         solo la pastilla crece y encoge. -->
    <Border x:Name="Pill"
            Width="{DynamicResource Size.Collapsed.Width}"
            Height="{DynamicResource Size.Collapsed.Height}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            ClipToBounds="True"
            Background="{DynamicResource Brush.Background}"
            CornerRadius="{DynamicResource Radius.Notch.Collapsed}"
            MouseEnter="OnPillMouseEnter"
            MouseLeave="OnPillMouseLeave">

        <!-- Contenido de prueba de M2. -->
        <TextBlock x:Name="ExpandedContent"
                   Text="Hola"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Main}"
                   FontSize="{DynamicResource FontSize.Title}"
                   Foreground="{DynamicResource Brush.Text}" />
    </Border>
</Window>
