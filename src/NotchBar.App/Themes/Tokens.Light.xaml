<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Colores (ver docs/04-UI-THEME.md). Mismos nombres en Tokens.Dark.xaml. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DADADA" />
    <SolidColorBrush x:Key="Brush.Text" Color="#111111" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D32F2F" />

    <!-- Medidas -->
    <sys:Double x:Key="Size.Collapsed.Width">220</sys:Double>
    <sys:Double x:Key="Size.Collapsed.Height">34</sys:Double>
    <sys:Double x:Key="Size.Expanded.Width">560</sys:Double>
    <sys:Double x:Key="Size.Expanded.Height">200</sys:Double>
    <CornerRadius x:Key="Radius.Notch.Collapsed">0,0,18,18</CornerRadius>
    <CornerRadius x:Key="Radius.Notch.Expanded">0,0,26,26</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>

    <FontFamily x:Key="Font.Main">Segoe UI Variable, Segoe UI</FontFamily>
</ResourceDictionary>
