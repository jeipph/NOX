<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos de controles reutilizables. Solo usan tokens (DynamicResource). -->

    <!-- Botón redondo con un icono de la fuente Segoe Fluent Icons. -->
    <Style x:Key="IconButton" TargetType="Button">
        <!-- El notch nunca toma el foco del teclado. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etiqueta pequeña que se puede pulsar (por ejemplo, el reproductor elegido). -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Main}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Micro}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="{DynamicResource Brush.Surface}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{DynamicResource Padding.Chip}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progreso fina. WPF ajusta el ancho de PART_Indicator según Value. -->
    <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="{DynamicResource Size.Progress}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource Brush.Border}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
