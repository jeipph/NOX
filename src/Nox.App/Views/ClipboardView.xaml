<UserControl x:Class="Nox.App.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nox.App.Views">
    <!-- DataContext: ClipboardViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Padding.Expanded}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Copia un texto en cualquier programa y aparecerá aquí"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Main}"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Lista con la rueda del ratón (sin barra visible, para que quede limpio). -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{DynamicResource ListRowButton}"
                                    Content="{Binding Preview}"
                                    ToolTip="{Binding Text}"
                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=views:ClipboardView}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Preview, StringFormat=Copiar: {0}}" />

                            <!-- E718 chinche vacío (sin fijar), E840 chinche relleno (fijado) -->
                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=views:ClipboardView}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                                        <Setter Property="Content" Value="&#xE718;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Setter Property="ToolTip" Value="Fijar (se guarda aunque cierres la app)" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Preview, StringFormat=Fijar: {0}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Content" Value="&#xE840;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                <Setter Property="ToolTip" Value="Quitar de fijados" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Preview, StringFormat=Quitar fijado: {0}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1"
                Style="{DynamicResource ChipButton}"
                HorizontalAlignment="Left"
                Content="Borrar historial"
                ToolTip="Borra las copias recientes; los fijados se quedan"
                Command="{Binding ClearRecentCommand}"
                Visibility="{Binding HasItems, Converter={StaticResource VisibleIfTrue}}"
                AutomationProperties.Name="Borrar historial" />
    </Grid>
</UserControl>
