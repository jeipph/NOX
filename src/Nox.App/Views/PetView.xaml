<UserControl x:Class="Nox.App.Views.PetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pets="clr-namespace:Nox.Core.Pets;assembly=Nox.Core">
    <!-- DataContext: PetViewModel. La animación solo corre mientras se ve (PetView.xaml.cs). -->
    <Grid Margin="{DynamicResource Padding.Expanded}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Elegir mascota -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Gato gris"
                    Margin="{DynamicResource Space.Chip}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static pets:PetKind.GrayCat}"
                    AutomationProperties.Name="Mascota gato gris">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGrayCat}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Gato atigrado"
                    Margin="{DynamicResource Space.Chip}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static pets:PetKind.TabbyCat}"
                    AutomationProperties.Name="Mascota gato atigrado">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbyCat}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Beagle"
                    Margin="{DynamicResource Space.Chip}"
                    Command="{Binding ChooseCommand}"
                    CommandParameter="{x:Static pets:PetKind.Beagle}"
                    AutomationProperties.Name="Mascota beagle">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBeagle}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Escenario: suelo abajo; los píxeles se amplían sin suavizar (pixel art nítido). -->
        <Canvas x:Name="Stage"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                ClipToBounds="True"
                RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Rectangle x:Name="Ground" Height="{DynamicResource Size.PetGround}" Fill="{DynamicResource Brush.Border}" />
            <Image x:Name="BallImage" RenderTransformOrigin="0.5,0.5" />
            <Image x:Name="PetImage" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Mascota">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="PetFlip" />
                </Image.RenderTransform>
            </Image>
        </Canvas>
    </Grid>
</UserControl>
