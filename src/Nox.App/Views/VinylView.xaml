<UserControl x:Class="Nox.App.Views.VinylView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: NowPlayingViewModel (carátula, título, si suena). -->

    <Grid Margin="{DynamicResource Padding.Expanded}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- El disco entero gira alrededor de su centro. -->
        <Grid x:Name="Disc"
              Width="{DynamicResource Size.Vinyl}"
              Height="{DynamicResource Size.Vinyl}"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="Rotation" />
            </Grid.RenderTransform>

            <!-- Vinilo y surcos -->
            <Ellipse Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" />
            <Ellipse Width="{DynamicResource Size.VinylGrooveOuter}" Height="{DynamicResource Size.VinylGrooveOuter}"
                     Stroke="{DynamicResource Brush.Border}" />
            <Ellipse Width="{DynamicResource Size.VinylGrooveInner}" Height="{DynamicResource Size.VinylGrooveInner}"
                     Stroke="{DynamicResource Brush.Border}" />

            <!-- Etiqueta central: la carátula recortada en círculo -->
            <Ellipse Width="{DynamicResource Size.VinylLabel}" Height="{DynamicResource Size.VinylLabel}"
                     Fill="{DynamicResource Brush.SurfaceHover}" />
            <Ellipse Width="{DynamicResource Size.VinylLabel}" Height="{DynamicResource Size.VinylLabel}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <!-- Agujero -->
            <Ellipse Width="{DynamicResource Size.VinylHole}" Height="{DynamicResource Size.VinylHole}"
                     Fill="{DynamicResource Brush.Background}" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="{DynamicResource Space.Gap}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Title}"
                       FontWeight="{DynamicResource FontWeight.Title}"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding Artist}"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}" />
        </StackPanel>
    </Grid>
</UserControl>
