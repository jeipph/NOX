<Window x:Class="Nox.App.Windows.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nox.App.ViewModels"
        Title="NOX · Atajos de teclado"
        Icon="/Assets/nox.ico"
        Width="{DynamicResource Size.HotkeysWindow.Width}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Main}"
        FontSize="{DynamicResource FontSize.Small}">
    <!-- DataContext: HotkeysViewModel -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </Window.Resources>

    <StackPanel Margin="{DynamicResource Padding.Window}">
        <CheckBox Content="Activar los atajos de teclado"
                  Foreground="{DynamicResource Brush.Text}"
                  IsChecked="{Binding Enabled}"
                  Margin="{DynamicResource Space.Row}" />

        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Margin="{DynamicResource Space.Row}"
                   Text="Haz clic en un cuadro y pulsa la combinación nueva (con Ctrl, Alt o Win). Retroceso o Supr la quita. Funcionan aunque estés en otra app." />

        <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding Enabled}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
                    <Grid Margin="{DynamicResource Space.Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{DynamicResource Size.HotkeyBox}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Problem}"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       FontSize="{DynamicResource FontSize.Micro}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasProblem, Converter={StaticResource VisibleIfTrue}}" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource NoteTextBox}"
                                 AcceptsReturn="False"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 TextAlignment="Center"
                                 Text="{Binding Text, Mode=OneWay}"
                                 AutomationProperties.Name="{Binding Label, StringFormat=Atajo para {0}}"
                                 PreviewKeyDown="OnHotkeyBoxKeyDown"
                                 GotKeyboardFocus="OnHotkeyBoxFocused"
                                 LostKeyboardFocus="OnHotkeyBoxUnfocused" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Content="Restablecer"
                    Command="{Binding ResetDefaultsCommand}" AutomationProperties.Name="Restablecer atajos" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Cerrar"
                    Click="OnCloseClick" AutomationProperties.Name="Cerrar" />
        </DockPanel>
    </StackPanel>
</Window>
