<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Medidas, tiempos y tipografía: iguales en todos los temas (ver docs/04-UI-THEME.md).
         Los colores están en Tokens.Dark.xaml / Tokens.Light.xaml. -->

    <!-- La ventana es transparente y siempre mide esto; dentro crece y encoge la pastilla. -->
    <sys:Double x:Key="Size.Window.Width">560</sys:Double>
    <sys:Double x:Key="Size.Window.Height">248</sys:Double>

    <sys:Double x:Key="Size.Collapsed.Width">220</sys:Double>
    <sys:Double x:Key="Size.Collapsed.Height">34</sys:Double>
    <sys:Double x:Key="Size.Expanded.Width">560</sys:Double>
    <sys:Double x:Key="Size.Expanded.Height">236</sys:Double>
    <sys:Double x:Key="Size.Indicator.Width">60</sys:Double>
    <sys:Double x:Key="Size.Indicator.Height">6</sys:Double>

    <CornerRadius x:Key="Radius.Notch.Collapsed">0,0,18,18</CornerRadius>
    <CornerRadius x:Key="Radius.Notch.Expanded">0,0,26,26</CornerRadius>
    <CornerRadius x:Key="Radius.Capsule.Collapsed">17</CornerRadius>
    <CornerRadius x:Key="Radius.Capsule.Expanded">26</CornerRadius>
    <CornerRadius x:Key="Radius.Indicator">0,0,3,3</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>

    <!-- Separación del borde superior según el estilo. -->
    <Thickness x:Key="Margin.Notch">0</Thickness>
    <Thickness x:Key="Margin.Capsule">0,8,0,0</Thickness>

    <!-- Panel "Ahora suena" -->
    <Thickness x:Key="Padding.Expanded">20,16,20,8</Thickness>
    <sys:Double x:Key="Size.Cover">128</sys:Double>
    <sys:Double x:Key="Size.IconButton">36</sys:Double>
    <sys:Double x:Key="Size.IconButtonSmall">28</sys:Double>
    <sys:Double x:Key="Size.Progress">3</sys:Double>
    <sys:Double x:Key="Size.SliderThumb">10</sys:Double>
    <!-- Alto de la zona que se puede pulsar del deslizador (más que la línea, para acertar fácil) -->
    <sys:Double x:Key="Size.SliderHitHeight">20</sys:Double>
    <sys:Double x:Key="Size.VolumeSlider">140</sys:Double>
    <Thickness x:Key="Space.Above">0,6,0,0</Thickness>
    <Thickness x:Key="Space.Gap">16,0,0,0</Thickness>
    <Thickness x:Key="Space.Below">0,0,0,8</Thickness>
    <Thickness x:Key="Padding.Collapsed">16,0,16,0</Thickness>
    <Thickness x:Key="Padding.Chip">8,2,8,2</Thickness>
    <Thickness x:Key="Padding.Row">8,5,8,5</Thickness>

    <!-- Panel "Notas" -->
    <!-- Las columnas de WPF necesitan GridLength, no un número suelto -->
    <GridLength x:Key="Size.NotesListWidth">210</GridLength>
    <Thickness x:Key="Padding.NoteBox">8,6,8,6</Thickness>
    <!-- Donde aparece el texto de ayuda: el relleno del cuadro + el margen interno del texto de WPF -->
    <Thickness x:Key="Padding.Note">10,7,10,7</Thickness>
    <Thickness x:Key="Space.GapAbove">16,6,0,0</Thickness>
    <Thickness x:Key="Space.TabBar">0,0,0,10</Thickness>
    <Thickness x:Key="Space.Inline">8,0,8,0</Thickness>

    <!-- Panel "Letras" -->
    <Thickness x:Key="Space.LyricCurrent">0,6,0,6</Thickness>
    <sys:Double x:Key="FontSize.Lyric">18</sys:Double>
    <sys:Double x:Key="FontSize.LyricDim">14</sys:Double>
    <!-- Cuánto sube la línea nueva al aparecer -->
    <sys:Double x:Key="Lyric.SlideDistance">10</sys:Double>

    <!-- Panel "Enfoque" -->
    <sys:Double x:Key="FontSize.Timer">40</sys:Double>
    <sys:Double x:Key="Size.FocusProgress">260</sys:Double>
    <Thickness x:Key="Space.Chip">4</Thickness>
    <!-- Cuánto se queda abierto el notch al avisar de que terminó la concentración -->
    <sys:TimeSpan x:Key="Attention.Duration">00:00:06</sys:TimeSpan>

    <!-- Panel "Vinilo" -->
    <sys:Double x:Key="Size.Vinyl">150</sys:Double>
    <sys:Double x:Key="Size.VinylGrooveOuter">128</sys:Double>
    <sys:Double x:Key="Size.VinylGrooveInner">106</sys:Double>
    <sys:Double x:Key="Size.VinylLabel">72</sys:Double>
    <sys:Double x:Key="Size.VinylHole">8</sys:Double>
    <!-- Tiempo de una vuelta completa -->
    <sys:TimeSpan x:Key="Vinyl.TurnDuration">00:00:04</sys:TimeSpan>
    <!-- Imágenes por segundo del giro (60 sería el máximo de WPF) -->
    <sys:Int32 x:Key="Vinyl.FrameRate">30</sys:Int32>

    <!-- Panel "Mascota": cada píxel del dibujo se ve como un cuadrado de 4×4 -->
    <sys:Double x:Key="Pet.Scale">4</sys:Double>
    <!-- 20 imágenes por segundo: suficiente para pixel art y gasta poco -->
    <sys:TimeSpan x:Key="Pet.FrameInterval">00:00:00.05</sys:TimeSpan>
    <sys:Double x:Key="Size.PetGround">1</sys:Double>

    <!-- Ventana "Atajos de teclado" -->
    <sys:Double x:Key="Size.HotkeysWindow.Width">460</sys:Double>
    <Thickness x:Key="Padding.Window">20</Thickness>
    <GridLength x:Key="Size.HotkeyBox">170</GridLength>
    <Thickness x:Key="Space.Row">0,0,0,10</Thickness>

    <!-- Tiempos -->
    <sys:TimeSpan x:Key="Duration.Expand">00:00:00.22</sys:TimeSpan>
    <sys:TimeSpan x:Key="Duration.Fast">00:00:00.12</sys:TimeSpan>
    <sys:TimeSpan x:Key="Hover.CollapseDelay">00:00:00.4</sys:TimeSpan>

    <!-- Tipografía -->
    <FontFamily x:Key="Font.Main">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="FontSize.Title">15</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Micro">11</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <sys:Double x:Key="FontSize.IconSmall">13</sys:Double>
    <sys:Double x:Key="FontSize.IconLarge">20</sys:Double>
    <FontWeight x:Key="FontWeight.Title">SemiBold</FontWeight>

    <!-- Tiempo entre redibujos de la barra de progreso (solo con el notch abierto y la música sonando). -->
    <sys:TimeSpan x:Key="Progress.Interval">00:00:00.5</sys:TimeSpan>
</ResourceDictionary>
