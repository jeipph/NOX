<Application x:Class="Nox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:models="clr-namespace:Nox.Core.Models;assembly=Nox.Core"
             xmlns:converters="clr-namespace:Nox.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Layout.xaml" />
                <!-- Colores del tema activo. ThemeService lo cambiará en M9. -->
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Marca en el menú la opción igual al valor elegido (los minutos del descanso). -->
            <converters:EqualsConverter x:Key="EqualsConverter" />

            <!-- DataContext = NotchViewModel (se asigna en App.xaml.cs). -->
            <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="NOX" IconSource="/Assets/nox.ico">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mostrar el notch"
                                  Command="{Binding ShowNotchCommand}"
                                  ToolTip="Vuelve a mostrar el notch si lo ocultaste con ×" />
                        <MenuItem Header="Volver arriba al centro"
                                  Command="{Binding ResetPositionCommand}"
                                  ToolTip="Olvida dónde arrastraste el notch" />
                        <Separator />
                        <MenuItem Header="Estilo">
                            <MenuItem Header="Notch"
                                      IsChecked="{Binding IsNotchStyle, Mode=OneWay}"
                                      Command="{Binding SetStyleCommand}"
                                      CommandParameter="{x:Static models:NotchStyle.Notch}" />
                            <MenuItem Header="Cápsula"
                                      IsChecked="{Binding IsCapsuleStyle, Mode=OneWay}"
                                      Command="{Binding SetStyleCommand}"
                                      CommandParameter="{x:Static models:NotchStyle.Capsule}" />
                            <MenuItem Header="Indicador"
                                      IsChecked="{Binding IsIndicatorStyle, Mode=OneWay}"
                                      Command="{Binding SetStyleCommand}"
                                      CommandParameter="{x:Static models:NotchStyle.Indicator}" />
                        </MenuItem>
                        <MenuItem Header="Visible solo al pasar el ratón"
                                  IsCheckable="True"
                                  IsChecked="{Binding OnlyOnHover}" />
                        <MenuItem Header="Reservar la franja superior"
                                  IsCheckable="True"
                                  IsChecked="{Binding ReserveTopStrip}"
                                  ToolTip="Solo con el notch arriba al centro (no si lo arrastraste a otro sitio)" />
                        <MenuItem Header="Buscar letras en internet (lrclib.net)"
                                  IsCheckable="True"
                                  IsChecked="{Binding LyricsEnabled}"
                                  ToolTip="Envía título, artista y duración de la canción a lrclib.net" />
                        <MenuItem Header="Recordar descansar (la mascota aparece)">
                            <MenuItem Header="Cada 15 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=15}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="15" />
                            <MenuItem Header="Cada 20 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=20}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="20" />
                            <MenuItem Header="Cada 30 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=30}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="30" />
                            <MenuItem Header="Cada 40 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=40}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="40" />
                            <MenuItem Header="Cada 45 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=45}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="45" />
                            <MenuItem Header="Cada 60 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=60}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="60" />
                            <MenuItem Header="Cada 90 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=90}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="90" />
                            <MenuItem Header="Cada 120 min"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=120}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="120" />
                            <MenuItem Header="{Binding CustomBreakHeader}"
                                      IsChecked="{Binding IsBreakCustom, Mode=OneWay}"
                                      Command="{Binding ChooseCustomBreakCommand}" />
                            <MenuItem Header="Nunca"
                                      IsChecked="{Binding BreakMinutes, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"
                                      Command="{Binding SetBreakMinutesCommand}" CommandParameter="0" />
                            <Separator />
                            <MenuItem Header="Descansar ahora" Command="{Binding BreakNowCommand}" />
                        </MenuItem>
                        <MenuItem Header="Mascota en el notch cerrado"
                                  IsCheckable="True"
                                  IsChecked="{Binding PetInCollapsed}" />
                        <MenuItem Header="{Binding HotkeysMenuHeader}"
                                  Command="{Binding OpenHotkeysCommand}" />
                        <MenuItem Header="Limpiar caché y RAM…"
                                  Command="{Binding OpenCleanupCommand}" />
                        <MenuItem Header="Mantener el PC despierto"
                                  IsCheckable="True"
                                  IsChecked="{Binding KeepAwakeEnabled}"
                                  ToolTip="Mientras esté marcado, el PC no se suspende ni apaga la pantalla. Se desmarca al cerrar NOX." />
                        <Separator />
                        <MenuItem Header="Tema">
                            <MenuItem Header="Sistema (como Windows)"
                                      IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}"
                                      CommandParameter="{x:Static models:AppTheme.System}" />
                            <MenuItem Header="Oscuro"
                                      IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}"
                                      CommandParameter="{x:Static models:AppTheme.Dark}" />
                            <MenuItem Header="Claro"
                                      IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}"
                                      CommandParameter="{x:Static models:AppTheme.Light}" />
                        </MenuItem>
                        <MenuItem Header="Carpeta de notas…"
                                  Command="{Binding ChooseNotesFolderCommand}" />
                        <MenuItem Header="Iniciar con Windows"
                                  IsCheckable="True"
                                  IsChecked="{Binding StartWithWindows}" />
                        <Separator />
                        <MenuItem Header="Salir" Click="OnExitClick" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
